{
  "name": "tactile-ui-workspace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.34.8",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=10.34.8 <11"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:docs": "turbo run dev --filter=@tactile-ui/docs",
    "dev:native": "turbo run dev --filter=@tactile-ui/showcase",
    "build": "turbo run build",
    "build:packages": "turbo run build --filter=./packages/*",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "turbo run typecheck && tsc --project tsconfig.tools.json --noEmit && tsc --project tsconfig.tests.json --noEmit",
    "test": "turbo run test",
    "test:watch": "vitest",
    "test:browser": "playwright test",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm check:packages",
    "check:packages": "node scripts/check-packages.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build:packages && pnpm check:packages && changeset publish",
    "clean": "turbo run clean && rimraf .turbo"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.0",
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.5.0",
    "jsdom": "^27.0.0",
    "prettier": "^3.6.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rimraf": "^6.0.1",
    "tsup": "^8.5.0",
    "turbo": "2.11.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^4.0.0",
    "@testing-library/dom": "10.4.2"
  }
}
