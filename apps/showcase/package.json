{
  "name": "@tactile-ui/showcase",
  "version": "0.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "dev": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "build": "expo export --platform ios --platform android --output-dir dist",
    "typecheck": "tsc --noEmit",
    "doctor": "expo install --check",
    "clean": "rimraf dist .expo"
  },
  "dependencies": {
    "@tactile-ui/react-native": "workspace:*",
    "@tactile-ui/theme": "workspace:*",
    "@tactile-ui/tokens": "workspace:*",
    "expo": "~58.0.19",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "expo-system-ui": "~58.0.6"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "babel-preset-expo": "~58.0.0"
  }
}
